# Picked up by the lyzr SDK (Studio() reads LYZR_API_KEY automatically).
# Get yours from the Lyzr Studio dashboard. This file is a TEMPLATE — never
# put a real key here (it is committed to git). Real values go in backend/.env.
LYZR_API_KEY=sk-default-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Orchestrator agent ID (the "Auto Loan Underwriting Orchestrator").
LYZR_AGENT_ID=your_orchestrator_agent_id

# Optional: prod | dev | local. Defaults to prod.
LYZR_ENV=prod

# Optional: user id passed to the SDK's session.
LYZR_USER_ID=underwriter@company.com
