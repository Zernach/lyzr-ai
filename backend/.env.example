# Picked up by the lyzr SDK (Studio() reads LYZR_API_KEY automatically).
LYZR_API_KEY=sk-default-REDACTED

# Orchestrator agent ID (the "Auto Loan Underwriting Orchestrator").
LYZR_AGENT_ID=AGENT_ID_REDACTED

# Optional: prod | dev | local. Defaults to prod.
LYZR_ENV=prod

# Optional: user id passed to the SDK's session.
LYZR_USER_ID=underwriter@company.com
