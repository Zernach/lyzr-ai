rules_version = '2';

// Security rules for the Lyzr Underwriting Copilot.
//
// Roles live on users/{uid}.role ('underwriter' | 'applicant'). The backend
// (firebase/main.py) writes underwriting_jobs and applicant decisions via the
// Admin SDK, which bypasses these rules entirely — so the client paths below
// only govern what the browser is allowed to do.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUnderwriter() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'underwriter';
    }

    // ── users ──────────────────────────────────────────────────────────────
    // Signed-in users can read profiles (to render names); each user may
    // create/update only their own record. No deletes from the client.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── underwriting_rules (presets) ─────────────────────────────────────────
    // Everyone signed in can read the dropdown; only underwriters can edit.
    match /underwriting_rules/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isUnderwriter();
    }

    // ── applicants (kanban cards) ────────────────────────────────────────────
    // Underwriters have full access. An applicant may read and create cards
    // linked to themselves, and update their own — but cannot delete.
    match /applicants/{id} {
      allow read: if isUnderwriter()
        || (isSignedIn() && resource.data.linkedUserId == request.auth.uid);
      allow create: if isUnderwriter()
        || (isSignedIn()
            && request.resource.data.linkedUserId == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid);
      allow update: if isUnderwriter()
        || (isSignedIn() && resource.data.linkedUserId == request.auth.uid);
      allow delete: if isUnderwriter();
    }

    // ── underwriting_jobs ────────────────────────────────────────────────────
    // Reads: any signed-in user (to watch a live run + load prior findings).
    //
    // Creates: an underwriter may enqueue a *pending* job straight from the
    // browser. The Firestore-triggered backend (`process_job`) picks it up and
    // runs the crew. Keeping creation here — rather than on the backend HTTP
    // path — means the run starts the instant the browser writes the doc, even
    // when the server can't reach Firestore. Locked to status:'pending' with
    // the creator's own uid so a client can't forge a finished result.
    //
    // Updates/deletes stay backend-only (the Admin SDK bypasses these rules);
    // a client can never flip a job to done/error or rewrite its result.
    match /underwriting_jobs/{id} {
      allow read: if isSignedIn();
      allow create: if isUnderwriter()
        && request.resource.data.status == 'pending'
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.rules is string
        && request.resource.data.applicant is string;
      allow update, delete: if false;
    }

    // Default: deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
